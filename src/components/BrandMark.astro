---
/** Header mark — matches public/favicon.svg (rx=20). */
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
	class:list={['h-12 w-12 shrink-0 sm:h-14 sm:w-14', className]}
	viewBox="0 0 128 128"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-hidden="true"
>
	<rect width="128" height="128" rx="20" fill="#f59e0b"></rect>
	<text
		x="64"
		y="86"
		text-anchor="middle"
		font-family="ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif"
		font-size="68"
		font-weight="800"
		fill="#0c0a09"
		letter-spacing="-0.04em"
	>B</text>
</svg>
