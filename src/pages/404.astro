---
import BaseLayout from '../layouts/BaseLayout.astro';
import linksData from '../data/links.json';
import type { LinksData } from '../types/links';

const data = linksData as LinksData;
---

<BaseLayout
	title={`Not found — ${data.title}`}
	author={data.author}
	siteUrl={data.siteUrl}
	noindex
>
	<main class="relative mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-6 py-20 sm:px-8">
		<p class="font-display text-sm font-bold uppercase tracking-widest text-amber-500">404</p>
		<h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight text-stone-50 sm:text-5xl">
			Page not found
		</h1>
		<p class="mt-4 max-w-sm text-lg text-stone-400">That URL doesn&apos;t exist.</p>
		<p class="mt-12">
			<a href="/" class="btn-secondary">
				Back to links
			</a>
		</p>
	</main>
</BaseLayout>
