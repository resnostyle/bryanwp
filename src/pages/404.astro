---
import BaseLayout from '../layouts/BaseLayout.astro';
import linksData from '../data/links.json';
import type { LinksData } from '../types/links';

const data = linksData as LinksData;
---

<BaseLayout title={`Not found — ${data.title}`} siteUrl={data.siteUrl} noindex>
	<main class="relative mx-auto flex min-h-dvh max-w-md flex-col justify-center px-4 py-12 text-center">
		<h1 class="text-3xl font-bold tracking-tight text-slate-100">Page not found</h1>
		<p class="mt-3 text-slate-500">That URL does not exist.</p>
		<p class="mt-10">
			<a
				href="/"
				class="inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-800 px-5 py-2.5 text-sm font-medium text-slate-100 transition-colors duration-150 hover:border-slate-600 hover:bg-slate-700 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
			>
				Back to links
			</a>
		</p>
	</main>
</BaseLayout>
